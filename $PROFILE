# [1] Early Environment (Fast)
`$env:POWERSHELL_TELEMETRY_OPTOUT = \"1\"
`$env:EDITOR = \"nvim\"
`$env:PAGER  = \"less\"
`$ErrorActionPreference = \"SilentlyContinue\"
`$ProgressPreference = \"SilentlyContinue\"
# Disable Telemetry
`$global:PSProfileLoadTime = `$null

# [2] Optimized Prompt (Static OMP)
if (Get-Command oh-my-posh -ErrorAction Ignore) {
    `$ompCache = Join-Path `$env:TEMP \"omp-init.ps1\"
    if (Test-Path `$ompCache) {
        . `$ompCache
    } else {
        oh-my-posh init pwsh --config \"`$env:POSH_THEMES_PATH/tokyo.omp.json\" | Out-File -FilePath `$ompCache -Encoding utf8
        . `$ompCache
    }
}

# [3] Fast Forgum (Static Cow)
if (Get-Module Forgum -ListAvailable) {
    # Static cow + fortune is much faster than LiveShow
    Invoke-Forgum -Lolcat
}
# Enable truecolor
if (-not `$env:COLORTERM) { `$env:COLORTERM = 'truecolor' }

# [4] Dynamic Module Loading
function ls {
    if (-not (Get-Module Terminal-Icons -ErrorAction Ignore)) { Import-Module Terminal-Icons }
    Get-ChildItem -Force | Sort-Object @{Expression={`$_.PSIsContainer};Descending=`$true}, Name
}

function gs {
    if (-not (Get-Module posh-git -ErrorAction Ignore)) { Import-Module posh-git }
    git status
}

# [5] Essential Aliases & Helpers
Set-Alias grep Select-String
Set-Alias cat bat
Set-Alias vim nvim
if (Get-Command zoxide -ErrorAction Ignore) {
    zoxide init powershell | Out-String | Invoke-Expression
}
