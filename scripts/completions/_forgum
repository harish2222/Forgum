# Zsh completion for Forgum (forgum CLI wrapper)
# To enable:
#   1) Copy this file to one of:
#        - /usr/share/zsh/site-functions/_forgum
#        - ~/.zsh/completions/_forgum
#        - ~/.local/share/zsh/site-functions/_forgum
#   2) Ensure completion system is enabled:
#        autoload -Uz compinit && compinit
#   3) Reload your shell.

#compdef forgum

_forgum_subcommands=(
  update upgrade config tui setup gallery preview toggle animate eyes help
)

local curcontext="$curcontext" state line
typeset -A opt_args

# Decide what to complete based on the current word
curcontext="${curcontext}:forgum:${CURRENT_WORD}"
_arguments -C \
  '(-h --help)'{-h,--help}'[Show help]' \
  '(-Lolcat)'{-Lolcat}'[Enable lolcat for invocation]' \
  '(-CowFile)'{-CowFile}'[Cow file name]' \
  '(-Cow)'{-Cow}'[Alias for -CowFile]' \
  '(-Force)'{-Force}'[Force update]' \
  '(-CheckOnly)'{-CheckOnly}'[Only check for update]' \
  '(-Count)'{-Count}'[Gallery count]:count:' \
  '(-Mode)'{-Mode}'[Animation mode]:mode:' \
  '(-Preset)'{-Preset}'[Eyes preset]:preset:' \
  '(-CustomEyes)'{-CustomEyes}'[Custom eyes (2 chars)]:customeyes:' \
  '(-Background)'{-Background}'[Enable background for some animations]' \
  '1:subcommand:->subcmd' \
  '*::arg:->args'

case "$state" in
  subcmd)
    compadd -- ${_forgum_subcommands[@]}
    ;;
  args)
    # If completing a subcommand token
    # Otherwise complete generic flags/known args.
    if [[ "$words[CURRENT-1]" == "gallery" ]]; then
      # -Count expects an int; offer 1..10
      if [[ "$CURRENT_WORD" == -* ]]; then
        compadd -- -Count
      else
        compadd -- {1..10}
      fi
    else
      # Generic flag completion (best-effort)
      compadd -- -Lolcat -Cow -CowFile -Count -PreviewCow -PreviewText -Mode -Preset -CustomEyes -Force -CheckOnly -Background -Animation
    fi
    ;;
esac
