# Zsh completion for Forgum (forgum CLI wrapper)
# To enable:
#   1) Copy this file to one of:
#        - /usr/share/zsh/site-functions/_forgum
#        - ~/.zsh/completions/_forgum
#        - ~/.local/share/zsh/site-functions/_forgum
#   2) Ensure completion system is enabled:
#        autoload -Uz compinit && compinit
#   3) Reload your shell.

#compdef forgum

_forgum_subcommands=(
  run cowsay list theme export history config interactive toggle animate eyes init daemon live gallery preview update help
)

local curcontext="$curcontext" state line
typeset -A opt_args

_forgum_flags=(
  '(-h --help)'{-h,--help}'[Show help]'
  '(-v --version)'{-v,--version}'[Show version]'
  '--cow[Cow template name]:cow:_files'
  '--eyes[Custom eyes (2 chars)]:eyes:'
  '--tongue[Custom tongue (2 chars)]:tongue:'
  '--thoughts[Thought bubble character]:thoughts:'
  '--mode[Animation mode]:mode:(static talking typewriter bounce wave wiggle dissolve fade-in slide-in disco blink dynamic procedural physics aurora plasma ember liquid-chrome shatter portal glitch neon-pulse random)'
  '--count[Number of times to run]:count:'
  '--lolcat[Enable rainbow colors]'
  '--no-lolcat[Disable rainbow colors]'
  '--fortune[Force new random fortune]'
  '--no-color[Disable colors]'
  '--format[Output format]:format:(txt ansi)'
  '--output[Output file path]:output:_files'
  '--search[Search cow templates]:search:'
  '--clear[Clear history]'
  '--duration[Animation duration]:duration:'
  '--force[Force update]'
  '--check[Only check for update]'
  '--preset[Eye preset name]:preset:'
  '--custom[Custom eye characters]:custom:'
)

_arguments -C \
  "${_forgum_flags[@]}" \
  '1:subcommand:->subcmd' \
  '*::arg:->args'

case "$state" in
  subcmd)
    compadd -- ${_forgum_subcommands[@]}
    ;;
  args)
    case "$words[CURRENT-1]" in
      run)
        compadd -- --cow --mode --lolcat --no-lolcat --fortune --help
        ;;
      gallery)
        compadd -- --count --help
        ;;
      list)
        compadd -- --search --count --help
        ;;
      theme)
        compadd -- set list reset --help
        ;;
      export)
        compadd -- --cow --eyes --tongue --format --output --no-color --help
        ;;
      history)
        compadd -- --clear --count --help
        ;;
      config)
        compadd -- path dir show --help
        ;;
      cowsay)
        compadd -- --cow --eyes --tongue --thoughts --lolcat --no-color --help
        ;;
      live)
        compadd -- --duration --help
        ;;
      update)
        compadd -- --force --check --help
        ;;
      *)
        compadd -- ${_forgum_subcommands[@]}
        ;;
    esac
    ;;
esac
